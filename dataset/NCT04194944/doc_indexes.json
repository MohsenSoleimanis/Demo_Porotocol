  "glossary": [
    {
      "surface": "End of Study",
      "definition": "The end of the study is defined as the date of the last visit of the last participant in the study or last scheduled procedure shown in the SoA for the last participant in the trial globally.",
      "source_chunk_id": "NCT04194944_p40_b5"
    },
    {
      "surface": "Events meeting the AE definition",
      "definition": "Any abnormal laboratory test results or other safety assessments, for example, ECG, radiological scans, and vital signs measurements, including those that worsen from baseline, considered clinically significant in the medical and scientific judgment of the investigator, that is, not related to progression of underlying disease.",
      "source_chunk_id": "NCT04194944_p71_b12"
    },
    {
      "surface": "Exacerbation of a chronic or intermittent pre-existing condition",
      "definition": "Including either an increase in frequency and/or intensity of the condition.",
      "source_chunk_id": "NCT04194944_p71_b14"
    },
    {
      "surface": "New condition",
      "definition": "Detected or diagnosed after study intervention administration even though it may have been present before the start of the study.",
      "source_chunk_id": "NCT04194944_p72_b4"
    },
    {
      "surface": "Signs, symptoms, or the clinical sequelae of a suspected drug-drug interaction",
      "definition": "",
      "source_chunk_id": "NCT04194944_p72_b5"
    },
    {
      "surface": "Medication error, misuse, or abuse of IMP",
      "definition": "Including signs, symptoms, or clinical sequelae.",
      "source_chunk_id": "NCT04194944_p72_b6"
    },
    {
      "surface": "Lack of efficacy or failure of expected pharmacological action",
      "definition": "Per se will not be reported as an AE or SAE. Such instances will be captured in the efficacy assessments.",
      "source_chunk_id": "NCT04194944_p72_b7"
    },
    {
      "surface": "Woman of Childbearing Potential (WOCBP)",
      "definition": "A woman is considered fertile following menarche and until becoming postmenopausal unless permanently sterile.",
      "source_chunk_id": "NCT04194944_p95_b6"
    },
    {
      "surface": "Postmenopausal state",
      "definition": "Defined as no menses for 12 months without an alternative medical cause.",
      "source_chunk_id": "NCT04194944_p95_b18"
    }
  ],
